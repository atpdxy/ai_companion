{
  "openapi": "3.1.0",
  "info": {
    "title": "Companion Internal AI API",
    "version": "0.2.0"
  },
  "paths": {
    "/internal/v1/audio/transcriptions": {
      "post": {
        "summary": "Transcription",
        "operationId": "transcription_internal_v1_audio_transcriptions_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptionResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    },
    "/internal/v1/audio/speech": {
      "post": {
        "summary": "Speech",
        "operationId": "speech_internal_v1_audio_speech_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeechRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    },
    "/internal/v1/tools": {
      "get": {
        "summary": "Tools",
        "operationId": "tools_internal_v1_tools_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "title": "User Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ToolDescriptor"
                  },
                  "title": "Response Tools Internal V1 Tools Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    },
    "/internal/v1/tools/invoke": {
      "post": {
        "summary": "Invoke",
        "operationId": "invoke_internal_v1_tools_invoke_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolCall"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Invoke Internal V1 Tools Invoke Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    },
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/agent/respond": {
      "post": {
        "summary": "Agent Respond",
        "operationId": "agent_respond_internal_v1_agent_respond_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RespondRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AgentState": {
        "properties": {
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "valence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": -1.0,
            "title": "Valence",
            "default": 0.15
          },
          "arousal": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Arousal",
            "default": 0.25
          },
          "familiarity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Familiarity",
            "default": 0
          },
          "interaction_energy": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Interaction Energy",
            "default": 0.8
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AgentState"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 12000,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Memory": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "content": {
            "type": "string",
            "maxLength": 1000,
            "title": "Content"
          },
          "type": {
            "type": "string",
            "enum": [
              "semantic",
              "episodic",
              "boundary"
            ],
            "title": "Type",
            "default": "semantic"
          },
          "consent_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "title": "Consent Status",
            "default": "pending"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 1
          },
          "importance": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Importance",
            "default": 0.5
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "content"
        ],
        "title": "Memory"
      },
      "Persona": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": ""
          },
          "card_id": {
            "type": "string",
            "title": "Card Id",
            "default": ""
          },
          "relationship": {
            "type": "string",
            "enum": [
              "lover",
              "family",
              "friend",
              "custom"
            ],
            "title": "Relationship",
            "default": "lover"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "title": "Description",
            "default": ""
          },
          "greeting": {
            "type": "string",
            "maxLength": 500,
            "title": "Greeting",
            "default": ""
          },
          "voice_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Voice Id",
            "default": ""
          },
          "name": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "Name",
            "default": "知夏"
          },
          "user_name": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "User Name",
            "default": "你"
          },
          "warmth": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Warmth",
            "default": 0.85
          },
          "brevity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Brevity",
            "default": 0.6
          },
          "humor": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Humor",
            "default": 0.35
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Persona"
      },
      "RespondRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Request Id"
          },
          "turn_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Turn Id"
          },
          "user_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "User Id"
          },
          "conversation_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Conversation Id"
          },
          "message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Message"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Context"
          },
          "memories": {
            "items": {
              "$ref": "#/components/schemas/Memory"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Memories"
          },
          "persona": {
            "$ref": "#/components/schemas/Persona"
          },
          "state": {
            "$ref": "#/components/schemas/AgentState"
          },
          "memory_consent": {
            "type": "boolean",
            "title": "Memory Consent",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "turn_id",
          "user_id",
          "conversation_id",
          "message"
        ],
        "title": "RespondRequest"
      },
      "SpeechRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text"
          },
          "voice_id": {
            "type": "string",
            "maxLength": 100,
            "title": "Voice Id",
            "default": ""
          },
          "request_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "request_id"
        ],
        "title": "SpeechRequest"
      },
      "ToolCall": {
        "properties": {
          "user_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "User Id"
          },
          "tool_id": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Tool Id"
          },
          "request_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Request Id"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "tool_id",
          "request_id",
          "arguments"
        ],
        "title": "ToolCall"
      },
      "ToolDescriptor": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "input_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input Schema"
          }
        },
        "type": "object",
        "required": [
          "id",
          "description",
          "input_schema"
        ],
        "title": "ToolDescriptor"
      },
      "TranscriptionRequest": {
        "properties": {
          "audio_base64": {
            "type": "string",
            "maxLength": 14000000,
            "minLength": 4,
            "title": "Audio Base64"
          },
          "format": {
            "type": "string",
            "enum": [
              "wav",
              "mp3",
              "webm",
              "ogg",
              "opus",
              "flac",
              "m4a",
              "mp4",
              "aac"
            ],
            "title": "Format"
          },
          "request_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "audio_base64",
          "format",
          "request_id"
        ],
        "title": "TranscriptionRequest"
      },
      "TranscriptionResult": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Text"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 300.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TranscriptionResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
