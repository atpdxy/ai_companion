# 复制为根目录 .env；不要提交真实密钥。
POSTGRES_USER=companion
POSTGRES_PASSWORD=local-development-change-me
POSTGRES_DB=companion
DATABASE_URL=postgres://companion:local-development-change-me@localhost:25432/companion?sslmode=disable
REDIS_URL=redis://localhost:26379/0
API_ADDR=127.0.0.1:18080
AI_URL=http://127.0.0.1:18001
SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-characters
JWT_SECRET=replace-with-a-different-random-jwt-secret-at-least-32-characters
LLM_MODE=demo
LLM_BASE_URL=https://aigw.telecomjs.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash-new
LLM_TIMEOUT_SECONDS=40
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=2
EMOTION_TIMEOUT_SECONDS=12
GENERATION_TIMEOUT_SECONDS=65
MEMORY_TIMEOUT_SECONDS=10
ASR_ENABLED=false
ASR_URL=https://aigw.telecomjs.com/api/v1/services/aigc/multimodal-generation/generation
ASR_MODEL=qwen-audio-3.0-asr-flash
# 留空时复用 LLM_API_KEY，可独立配置语音密钥
ASR_API_KEY=
TTS_ENABLED=false
TTS_URL=https://aigw.telecomjs.com/api/v3/tts/unidirectional
TTS_MODEL=seed-tts-2.0
TTS_SPEAKER=zh_female_vv_uranus_bigtts
TTS_API_KEY=
AUDIO_TIMEOUT_SECONDS=75
# 默认无外部 MCP 连接。将示例复制到 .local/mcp.servers.json 后填写路径。
MCP_SERVERS_FILE=
MCP_TIMEOUT_SECONDS=15
WEB_ORIGIN=http://localhost:5173
